{
  "name": "ecarteo-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "config:check": "node --env-file-if-exists=.env.local scripts/validate-config.mjs",
    "test:integration": "vitest run tests/workspace-server.test.ts tests/workspace-pagination.test.ts tests/accounts-requests.test.ts tests/billing-server.test.ts tests/operations-server.test.ts tests/registration-analytics-server.test.ts",
    "build:marketing": "node scripts/build-marketing.mjs",
    "test:marketing": "node static-marketing/verify-build.mjs",
    "test:marketing:e2e": "playwright test --config=playwright.marketing.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.80.0",
    "idb": "^8.0.3",
    "next": "^16.4.6",
    "postgres": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
