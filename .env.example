# Copy to .env.local. Never commit real credentials.
# Public pages run without these values. Authentication fails closed until configured.
APP_URL=http://127.0.0.1:3000
# fullstack for local development, Docker and the single Render service.
# On Render, leave APP_URL blank to use the assigned HTTPS origin.
ECARTEO_DEPLOYMENT_TARGET=fullstack
# Frontend only: exact Render HTTPS origin; leave empty on backend/fullstack.
ECARTEO_BACKEND_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase Session/Transaction Pooler URI with database owner credentials.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional PEM CA certificate if required by your Supabase database connection.
SUPABASE_DB_CA_CERT=

# Private readiness endpoint: generate with `openssl rand -hex 32`.
OPS_HEALTH_TOKEN=

# Optional self-service billing. Leave all blank for quotation-based service.
# Use Stripe test mode during staging; never put secret keys in NEXT_PUBLIC_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Approved commercial plans only. Amount and currency are read from Stripe.
# STRIPE_BILLING_PLANS='[{"id":"approved-plan","name":"Approved offer","priceId":"price_..."}]'
STRIPE_BILLING_PLANS=

# Maintenance scripts only. Do not enable a maintenance window on a serving application.
# Use the scripts' --directory option for an encrypted backup destination.
# ECARTEO_MAINTENANCE_CONFIRMED=yes
